{
  "name": "bmos_demo",
  "version": "1.0.0",
  "main": "main.js",
  "bin": "server.js",
  "scripts": {
    "start": "chcp 65001 && electron .",
    "dev": "chcp 65001 && nodemon --watch server.js --watch main.js --exec electron .",
    "build": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.bmos.server",
    "productName": "BMOS_Server",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "BMOS_Server.exe",
      "requestExecutionLevel": "user"
    }
  },
  "author": "vuanh",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "express": "^5.2.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1",
    "nodemon": "^3.1.11"
  }
}
